# =========================================================================
# PK IT Consultants — Production Environment Configuration Template
# =========================================================================

# 1. DATABASE
# PostgreSQL connection string (e.g. Neon, AWS RDS, Supabase, or self-hosted)
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# 2. SECURITY & AUTHENTICATION
# Random secret strings used to sign tokens and sessions (e.g., openssl rand -base64 32)
JWT_SECRET="your-jwt-signing-key-minimum-32-chars"
AUTH_SECRET="your-next-auth-secret-minimum-32-chars"

# The base canonical domain URL of the application
AUTH_URL="https://www.pkitconsultants.com"
NEXT_PUBLIC_APP_URL="https://www.pkitconsultants.com"

# 3. EMAIL COMMUNICATIONS — GODADDY MICROSOFT 365 / ENTERPRISE
# Active Provider Selection: "graph" (recommended) or "smtp"
EMAIL_PROVIDER="graph"

# Option A: Microsoft Graph API with OAuth 2.0 (RECOMMENDED FOR MICROSOFT 365)
# Zero basic auth, fully compatible with M365 Security Defaults & MFA.
# Created via Azure Portal (portal.azure.com) -> Microsoft Entra ID -> App registrations
AZURE_TENANT_ID="your-azure-ad-tenant-id"
AZURE_CLIENT_ID="your-app-registration-client-id"
AZURE_CLIENT_SECRET="your-app-registration-client-secret"
AZURE_SENDER_EMAIL="info@pkitconsultants.com"

# Option B: Microsoft 365 Direct Authenticated SMTP (Alternative)
# Note: Requires SMTP AUTH enabled on tenant and mailbox (no MFA/Security Defaults blocking).
SMTP_HOST="smtp.office365.com"
SMTP_PORT=587
SMTP_USER="info@pkitconsultants.com"
SMTP_PASSWORD="your-m365-mailbox-password-or-app-password"

# Sender Identity & Admin Routing
FROM_EMAIL="info@pkitconsultants.com"
FROM_NAME="PK IT Consultants"
ADMIN_NOTIFICATION_EMAIL="info@pkitconsultants.com"

# 4. ENVIRONMENT CONTROL
NODE_ENV="production"
